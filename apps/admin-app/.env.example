EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# --- Push notifications (Option B: real Android push via Expo + Firebase) ---
# Expo project id from `npx eas init` (Expo dashboard). Required to mint a push token.
EAS_PROJECT_ID=
# Path to the Firebase google-services.json for the Android app
# (package: com.bambamcakeshop.admin). Default: ./google-services.json
GOOGLE_SERVICES_JSON=./google-services.json
